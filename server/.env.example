# VisionGuard Server 环境变量配置
# 复制此文件为 .env 并修改

# 监听端口
PORT=3000
BIND_HOST=127.0.0.1

# 运行实例与私有数据目录。测试环境必须单独设置，账号与会话都保存于该目录。
VISIONGUARD_CHANNEL=vnext
# VISIONGUARD_DATA_DIR=../.local/test-server-data
# 服务停止时用 scripts/provision-account.js 创建账号；密码只经临时环境变量或 stdin 传入。

# 可选的独立 HTTPS 测试入口，两个文件必须同时指定。
# VISIONGUARD_TLS_CERT_FILE=/private/path/cert.pem
# VISIONGUARD_TLS_KEY_FILE=/private/path/key.pem

# 截图过期时间 (小时)，默认 72
SCREENSHOT_TTL_HOURS=72

# 截图清理间隔 (毫秒)，默认 3600000 (1小时)
CLEANUP_INTERVAL_MS=3600000

# 上传大小限制 (字节)，默认 2097152 (2MB)
MAX_UPLOAD_BYTES=2097152

# 是否启用 HTTP 截图上传 (true=检测端POST上传, false=纯WS按需拉取)
ENABLE_HTTP_SCREENSHOT_UPLOAD=false

# 报警记录保留时间 (小时)，默认 168 (7天)
ALERT_TTL_HOURS=168

# WS 最大并发连接数，默认 100
MAX_WS_CONNECTIONS=100
