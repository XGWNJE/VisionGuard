# VisionGuard Server 环境变量配置
# 复制此文件为 .env 并修改

# 监听端口
PORT=3000
BIND_HOST=127.0.0.1

# 仅隔离测试服务可开启控制台自动登录；必须另设 VISIONGUARD_DATA_DIR
VISIONGUARD_TEST_CONSOLE_AUTOLOGIN=false
# VISIONGUARD_DATA_DIR=../.local/test-server-data

# HTTP 管理读取凭据（必须设置；WS 不使用共享凭据）
API_KEY=REPLACE_WITH_PRIVATE_HTTP_KEY

# 私有逐节点登记；通过 scripts/provision-node.js 写入 .local/
VISIONGUARD_IDENTITIES_FILE=../.local/node-identities.json

# 截图过期时间 (小时)，默认 72
SCREENSHOT_TTL_HOURS=72

# 截图清理间隔 (毫秒)，默认 3600000 (1小时)
CLEANUP_INTERVAL_MS=3600000

# 上传大小限制 (字节)，默认 2097152 (2MB)
MAX_UPLOAD_BYTES=2097152

# 是否启用 HTTP 截图上传 (true=检测端POST上传, false=纯WS按需拉取)
ENABLE_HTTP_SCREENSHOT_UPLOAD=false

# 报警记录保留时间 (小时)，默认 168 (7天)
ALERT_TTL_HOURS=168

# WS 最大并发连接数，默认 100
MAX_WS_CONNECTIONS=100
