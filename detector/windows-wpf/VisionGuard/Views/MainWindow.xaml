<Window x:Class="VisionGuard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VisionGuard.ViewModels"
        xmlns:local="clr-namespace:VisionGuard.Views"
        mc:Ignorable="d"
        Title="VisionGuard"
        Height="640" Width="960"
        MinHeight="480" MinWidth="720"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容区 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0">

                    <!-- 监控 -->
                    <Button x:Name="BtnMonitor" Height="64" Margin="4,0,4,4"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding DataContext.NavigateToMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="BtnMonitor_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE7AD;" FontFamily="Segoe UI Symbol" FontSize="20"
                                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="监控" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsMonitorPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceLight}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryPressed}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 设置 -->
                    <Button x:Name="BtnSettings" Height="64" Margin="4,0,4,4"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding DataContext.NavigateToSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="BtnSettings_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe UI Symbol" FontSize="20"
                                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="设置" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceLight}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryPressed}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 服务器 -->
                    <Button x:Name="BtnServer" Height="64" Margin="4,0,4,4"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding DataContext.NavigateToServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="BtnServer_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE703;" FontFamily="Segoe UI Symbol" FontSize="20"
                                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="服务器" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsServerPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceLight}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryPressed}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 中间预览区 -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="6" Margin="12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="预览区占位（Phase 6 实现实时画面）"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧页面区 -->
            <Grid Grid.Column="2" Background="{StaticResource BackgroundDark}">
                <local:MonitorPage    DataContext="{Binding MonitorVm}"    Visibility="{Binding DataContext.IsMonitorPage,  RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <local:SettingsPage   DataContext="{Binding SettingsVm}"   Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <local:ServerPage     DataContext="{Binding ServerVm}"     Visibility="{Binding DataContext.IsServerPage,   RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding LastAlertText}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding InferMsText}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
