<Window x:Class="VisionGuard.Views.MaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VisionGuard.ViewModels"
        Title="遮罩区域编辑"
        WindowStyle="None"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 图像 + 遮罩 Canvas -->
        <Grid Grid.Row="0">
            <Image x:Name="BackgroundImage" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Canvas x:Name="MaskCanvas" Background="Transparent"
                    MouseLeftButtonDown="MaskCanvas_MouseLeftButtonDown"
                    MouseMove="MaskCanvas_MouseMove"
                    MouseLeftButtonUp="MaskCanvas_MouseLeftButtonUp"/>
        </Grid>

        <!-- 底部工具栏 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8">
                <Button Content="↩ 撤销" Style="{StaticResource DarkButton}" Margin="4,0"
                        Command="{Binding UndoCommand}"/>
                <Button Content="🗑 清空" Style="{StaticResource DarkButton}" Margin="4,0"
                        Command="{Binding ClearCommand}"/>
                <Separator Margin="8,0" Style="{x:Null}" Width="1" Background="{StaticResource BorderBrush}"/>
                <Button Content="❌ 取消" Style="{StaticResource DarkButton}" Margin="4,0" Click="Cancel_Click"/>
                <Button Content="✓ 确定" Style="{StaticResource PrimaryButton}" Margin="4,0" Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
