<UserControl x:Class="VisionGuard.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,8,8,8">
            <!-- 推理后端：标签与选择器共用一行 -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="推理设备" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="后端" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                    <!-- 后端清单按档位变化：legacy 档（Windows 7）没有 DirectML 提供程序，只提供 CPU。 -->
                    <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding BackendOptions}" SelectedIndex="{Binding SelectedBackendIndex}" />
                </Grid>
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="容量" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="DirectML 基线" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding DirectMlCapacity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="CPU 基线" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding CpuCapacity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/></StackPanel>
                </Grid>
                <TextBlock Text="容量仅用于性能提示，不阻止启动，也不会自动减路或降帧。" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="64,6,0,0"
                           ToolTip="加速失败时，具体回退原因会显示在对应来源中。"/>
            </StackPanel>

            <!-- 模型：选择、状态与动作形成两行 -->
            <StackPanel>
                <TextBlock Text="模型资源" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="模型" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                    <!-- 模型清单按运行环境决定（Win7 → YOLOv5，Win10+ → YOLO26），与后端 ModelManager.ModelKeys 同源。 -->
                    <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding ModelDisplayNames}" SelectedIndex="{Binding SelectedModelIndex}" />
                </Grid>
                <Grid Margin="64,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModelStatusText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ModelDownloadProgress}" Foreground="{StaticResource Primary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="下载" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadModelCommand}" MinWidth="72" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
