<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VisionGuard.Detector.Windows.Views.GlobalSettingsPage">
    <Grid Margin="16,0,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="CategoryList" SelectedIndex="0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SettingsNavItem}" Margin="0,12,12,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBoxItem Content="账号与设备"/>
            <ListBoxItem Content="模型资源"/>
            <ListBoxItem Content="外观"/>
            <ListBoxItem Content="后台运行"/>
            <ListBoxItem Content="版本与维护"/>
            <ListBoxItem Content="运行方式"/>
            <ListBoxItem Content="节点状态"/>
            <ListBoxItem Content="性能检测与分析"/>
        </ListBox>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceDark}" CornerRadius="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PaneScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryList}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                        <TextBlock Text="账号与设备" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,16"/>
                        <StackPanel DataContext="{Binding Connection}">
                            <StackPanel Style="{StaticResource SettingsSection}" IsEnabled="{Binding CanEditAccount}">
                                <Grid MinHeight="36" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前账号" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding AccountText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Button Content="退出登录" Command="{Binding LogoutCommand}" Style="{StaticResource PaneButton}"/>
                                    </Grid>
                                </Grid>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid MinHeight="36" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="0"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="账号" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="0,0,0,0">
                                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Style="{StaticResource PaneTextBox}" AutomationProperties.Name="Username"/>
                                        </Grid>
                                        <Grid Grid.Column="2"/>
                                    </Grid>
                                    <Grid MinHeight="36" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="密码" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="0,0,12,0">
                                            <PasswordBox PasswordChanged="AccountPasswordChanged" Loaded="AccountPasswordLoaded" Unloaded="AccountPasswordUnloaded" MaxLength="256" Height="36" AutomationProperties.Name="密码"/>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Button Content="登录" Command="{Binding LoginCommand}" Style="{StaticResource PanePrimaryButton}"/>
                                        </Grid>
                                    </Grid>
                                    <CheckBox Content="记住账号密码" IsChecked="{Binding RememberCredentials, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}" MinHeight="36" Margin="96,0,0,8"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LoginMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SettingsSection}">
                                <TextBlock Text="设备身份" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                <Grid MinHeight="36" Margin="0,0,0,12" IsEnabled="{Binding CanEditDeviceName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="设备名称" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Margin="0,0,12,0">
                                        <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PaneTextBox}" MaxLength="64" DataObject.Pasting="DeviceName_OnPasting" AutomationProperties.Name="设备名称"/>
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Button Content="应用名称" Command="{Binding ApplyNameCommand}" Style="{StaticResource PaneButton}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PaneScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryList}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                        <TextBlock Text="模型资源" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,16"/>
                        <StackPanel DataContext="{Binding Environment}">
                            <StackPanel Style="{StaticResource SettingsSection}">
                                <Grid MinHeight="36" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="0"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="推理后端" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Margin="0,0,0,0">
                                        <ComboBox ItemsSource="{Binding BackendOptions}" SelectedIndex="{Binding SelectedBackendIndex}" Style="{StaticResource PaneComboBox}"/>
                                    </Grid>
                                    <Grid Grid.Column="2"/>
                                </Grid>
                                <TextBlock Text="加速回退原因在对应来源的运行状态中显示。" Style="{StaticResource CaptionText}" Margin="96,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="模型资源" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12" MinHeight="60">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="112"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <ProgressBar Style="{StaticResource ThemeProgressBar}" Height="4" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding DownloadCommand}" Style="{StaticResource PaneButton}" VerticalAlignment="Top"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ModelDownloadProgress}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Visibility="{Binding HasModelNotice, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PaneScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryList}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                        <TextBlock Text="外观" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,16"/>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Button Content="跟随系统" Tag="0" Click="Appearance_OnClick" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PaneButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppearanceIndex}" Value="0">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="浅色" Tag="1" Click="Appearance_OnClick" Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PaneButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppearanceIndex}" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="深色" Tag="2" Click="Appearance_OnClick" Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PaneButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppearanceIndex}" Value="2">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                        <Grid MinHeight="36" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前外观" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Margin="0,0,0,0">
                                <TextBlock Text="{Binding AppearanceName}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="2"/>
                        </Grid>
                        <TextBlock Text="{Binding AppearanceStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PaneScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryList}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                        <TextBlock Text="后台运行" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,16"/>
                        <StackPanel DataContext="{Binding Connection}">
                            <Grid MinHeight="36" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="112"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="驻留状态" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding ResidentStatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Button Content="刷新状态" Command="{Binding RefreshResidentCommand}" Style="{StaticResource PaneButton}"/>
                                </Grid>
                            </Grid>
                            <TextBlock Text="关闭主窗口与完整退出是不同操作；完整退出同时关闭驻留程序。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="96,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PaneScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryList}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                        <TextBlock Text="版本与维护" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,16"/>
                        <StackPanel DataContext="{Binding Connection}">
                            <Grid MinHeight="36" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="112"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="客户端" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding VersionText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Button Content="{Binding UpdateButtonText}" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding IsUpdateButtonEnabled}" Style="{StaticResource PaneButton}"/>
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="96,0,0,24"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,0">
                                <Grid MinHeight="36" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="退出应用" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="停止全部检测，并关闭后台驻留。" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Button Content="完整退出" Command="{Binding FullExitCommand}" Style="{StaticResource PaneDangerButton}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PaneScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryList}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="800">
                        <TextBlock Text="运行方式 · 影响全部来源" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>
                        <StackPanel DataContext="{Binding Node}">
                            <!-- 节点级状态：本机推理 / 推流到其他推理节点，二选一。当前态用选中底色标出，
                 两个按钮都占满整行，避免长标签被窄栏截断。 -->
                            <StackPanel>
                                <TextBlock Text="本机状态" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                <Button Content="本机推理" Command="{Binding UseInferenceModeCommand}" ToolTip="在本机模型上跑检测并产生报警" Margin="0,0,0,8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PaneButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInferenceMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="推流到其他推理节点" Command="{Binding UsePushModeCommand}" ToolTip="把本机采集画面推给其他推理节点，本机不推理、不报警">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PaneButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPushMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding NodeModeHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,24"/>
                            </StackPanel>
                            <!-- 推流目标属于节点级设置，必须和两态开关同层：放进下面按来源作用域的 StackPanel 里，
                 绑定会落到来源槽位上（下拉、当前目标、提示全为空）。本机直接选同账号里的推理节点，
                 选中即关联；控制台仍是同等入口，两边改的是同一份绑定。 -->
                            <StackPanel Visibility="{Binding IsPushMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,24">
                                <TextBlock Text="推流目标" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <ComboBox Style="{StaticResource PaneComboBox}" ItemsSource="{Binding PushTargets}" SelectedItem="{Binding SelectedPushTarget, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanPickPushTarget}" ToolTip="同账号里的推理节点，离线与正在推流的节点也会列出并标注；也可以在控制台关联，两边是同一份绑定关系"/>
                                        <!-- 未选中时给下拉一个占位文案：空下拉看着像坏了。 -->
                                        <TextBlock Text="选择视觉推理节点" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedPushTarget}" Value="{x:Null}"/>
                                                                <Condition Binding="{Binding CanPickPushTarget}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource PaneButton}" Command="{Binding RefreshPushTargetsCommand}" ToolTip="重新读取同账号的推理节点" Margin="8,0,0,0"/>
                                    <Button Grid.Column="2" Content="解除关联" Style="{StaticResource PaneButton}" Command="{Binding UnbindPushTargetCommand}" ToolTip="解除本节点的推流目标；本节点所有来源一起解绑，被动方与控制台也能解" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding PushTargetText, StringFormat=当前目标：{0}}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding PushTargetHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasPushTargetHint, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="推流只发送采集画面本身：本机遮罩与检测规则在推流态不参与，切回本机推理后可调整。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PaneScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryList}" Value="6">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="800">
                        <TextBlock Text="节点状态" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>
                        <StackPanel DataContext="{Binding Connection}">
                            <StackPanel Style="{StaticResource SettingsSection}">
                                <TextBlock Text="服务连接" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                <Grid MinHeight="36" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="连接状态" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding ConnectionState}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Button Content="重新连接" Command="{Binding RetryCommand}" Style="{StaticResource PaneButton}"/>
                                    </Grid>
                                </Grid>
                                <StackPanel Visibility="{Binding AllowsTestEndpoint, Converter={StaticResource BoolToVis}}">
                                    <Grid MinHeight="36" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="0"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="隔离地址" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="0,0,0,0">
                                            <TextBox Text="{Binding ServiceAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PaneTextBox}" AutomationProperties.Name="ServiceAddress" IsReadOnly="{Binding IsLoggedIn}"/>
                                        </Grid>
                                        <Grid Grid.Column="2"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="连接仅代表控制通道；各来源媒体、推理和告警状态请查看来源概览。" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PaneScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryList}" Value="7"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel DataContext="{Binding Node.Performance}" MaxWidth="900">
                        <TextBlock Text="性能检测与分析" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>
                        <TextBlock Text="先启动需要检测的来源，再采样 10 秒。显示采集、遮罩、预处理、推理、解析与告警的实际耗时；推流来源显示采集、编码与发送耗时。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="开始性能检测" Command="{Binding StartCommand}" Style="{StaticResource PanePrimaryButton}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12"/>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,8"/>
                                    <TextBlock Text="{Binding Stages}" FontFamily="Consolas" TextWrapping="Wrap" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
