<UserControl x:Class="VisionGuard.Detector.Windows.Views.GlobalSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:VisionGuard.Detector.Windows.Icons"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,8,8,8">
            <!-- ═══ 推理设备与模型资源（原「运行环境」页） ═══ -->
            <StackPanel DataContext="{Binding Environment}">
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="推理设备" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="后端" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                        <!-- 后端清单按档位变化：legacy 档（Windows 7）没有 DirectML 提供程序，只提供 CPU。 -->
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding BackendOptions}" SelectedIndex="{Binding SelectedBackendIndex}" />
                    </Grid>
                    <TextBlock Text="加速失败时，具体回退原因会显示在对应来源中。" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="64,8,0,0"/>
                </StackPanel>

                <!-- 模型资源默认收起，需要下载或管理模型时再展开，避免全局设定首次打开被清单淹没。 -->
                <Expander IsExpanded="False" Margin="0,0,0,16">
                    <Expander.Header>
                        <TextBlock Text="模型资源" Style="{StaticResource SectionLabel}"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Background="{DynamicResource SurfaceLight}" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <icons:LucideIcon Kind="Check" Width="16" Height="16" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                         Background="{DynamicResource SurfaceLight}" Foreground="{DynamicResource Primary}" BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource ThemeProgressBar}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding DownloadCommand}"
                                                MinWidth="72" VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ModelDownloadProgress}" Foreground="{DynamicResource SelectedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasModelNotice, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- ═══ 连接、设备身份与驻留（原「连接」页） ═══ -->
            <StackPanel DataContext="{Binding Connection}">
                <StackPanel Margin="0,0,0,16" IsEnabled="{Binding CanEditAccount}">
                    <TextBlock Text="账号" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AccountText}" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                    <TextBlock Text="服务地址" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ServiceAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" AutomationProperties.Name="服务地址" ToolTip="服务地址；局域网或隔离测试时修改" Margin="0,0,0,12"/>
                    <TextBlock Text="账号" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" AutomationProperties.Name="账号" Margin="0,0,0,12"/>
                    <TextBlock Text="密码" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                    <PasswordBox PasswordChanged="AccountPasswordChanged" AutomationProperties.Name="密码" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="登录" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" MinWidth="72"/>
                        <Button Content="退出登录" Style="{StaticResource DarkButton}" Command="{Binding LogoutCommand}" MinWidth="88" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LoginMessage}" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoginError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="服务器" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ConnectionState}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Content="重连" Style="{StaticResource DarkButton}" Command="{Binding RetryCommand}" MinWidth="72" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="设备身份" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="名称" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="应用" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyNameCommand}" MinWidth="64" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- 驻留程序：独立进程，只表达状态；未运行时状态文本本身就是失败原因 -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="后台驻留" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ResidentStatusText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsResidentRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Content="刷新" Style="{StaticResource DarkButton}" Command="{Binding RefreshResidentCommand}" MinWidth="72" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="客户端" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource SelectedTextBrush}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding UpdateButtonText}" Style="{StaticResource DarkButton}" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding IsUpdateButtonEnabled}" MinWidth="88" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="完整退出" Style="{StaticResource DarkButton}" Command="{Binding FullExitCommand}" MinWidth="88" Margin="8,0,0,0"
                                ToolTip="停止检测端并关闭驻留程序；下次手动启动检测端会自动恢复驻留。"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
