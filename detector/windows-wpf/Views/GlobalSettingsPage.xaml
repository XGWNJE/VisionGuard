<UserControl x:Class="VisionGuard.Views.GlobalSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,8,8,8">
            <!-- ═══ 推理设备与模型资源（原「运行环境」页） ═══ -->
            <StackPanel DataContext="{Binding Environment}">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="推理设备" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="后端" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                        <!-- 后端清单按档位变化：legacy 档（Windows 7）没有 DirectML 提供程序，只提供 CPU。 -->
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding BackendOptions}" SelectedIndex="{Binding SelectedBackendIndex}" />
                    </Grid>
                    <TextBlock Text="加速失败时，具体回退原因会显示在对应来源中。" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="64,6,0,0"/>
                </StackPanel>

                <!-- 模型资源：清单直接表达「已下载/未下载/下载中」，按钮就在每一项上 -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="模型资源" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                    <ItemsControl ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Background="{StaticResource SurfaceLight}" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                            <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                         Background="{StaticResource SurfaceLight}" Foreground="{StaticResource Primary}" BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding DownloadCommand}"
                                                MinWidth="72" VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ModelDownloadProgress}" Foreground="{StaticResource Primary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasModelNotice, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </StackPanel>

            <!-- ═══ 连接、设备身份与驻留（原「连接」页） ═══ -->
            <StackPanel DataContext="{Binding Connection}">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="服务器" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ConnectionState}" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="重连" Style="{StaticResource DarkButton}" Command="{Binding RetryCommand}" MinWidth="72" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="设备身份" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="名称" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="应用" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyNameCommand}" MinWidth="64" Margin="7,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- 驻留程序：独立进程，只表达状态；未运行时状态文本本身就是失败原因 -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="驻留程序" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ResidentStatusText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="刷新" Style="{StaticResource DarkButton}" Command="{Binding RefreshResidentCommand}" MinWidth="72" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="客户端" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource Primary}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding UpdateButtonText}" Style="{StaticResource DarkButton}" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding IsUpdateButtonEnabled}" MinWidth="88" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
