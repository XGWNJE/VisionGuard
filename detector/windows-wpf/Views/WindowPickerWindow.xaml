<Window x:Class="VisionGuard.Views.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择采集窗口"
        Height="560" Width="680" MinHeight="420" MinWidth="520"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,16">
            <TextBlock Text="选择采集窗口" Style="{StaticResource HeroText}" FontSize="22"/>
            <TextBlock x:Name="HeaderText" Text="仅显示宽度和高度均大于 100 像素的可见窗口。"
                       Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource CardBorder}" Grid.Row="1" Padding="7" Margin="0,0,0,16">
            <Grid>
                <ListBox x:Name="WindowList" Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="WindowList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceLight}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#26FF3B30"/><Setter Property="Foreground" Value="White"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="12,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat=" ({0}x{1})">
                                            <Binding Path="Bounds.Width"/>
                                            <Binding Path="Bounds.Height"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LoadingIndicator" Text="正在枚举窗口..."
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="刷新列表" Style="{StaticResource GhostButton}" MinWidth="96" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="取消" Style="{StaticResource DarkButton}" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="使用此窗口" Style="{StaticResource PrimaryButton}" MinWidth="118" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
