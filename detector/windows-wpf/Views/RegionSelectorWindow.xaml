<Window x:Class="VisionGuard.Detector.Windows.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        Cursor="Cross">
    <Grid>
        <!-- 背景图（仅在窗口子区域模式时显示） -->
        <Image x:Name="BackgroundImage" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 暗化遮罩（全屏模式时覆盖整个屏幕；窗口模式时覆盖图像） -->
        <Rectangle x:Name="DimOverlay" Fill="#AA000000"/>

        <!-- 交互画布 -->
        <Canvas x:Name="OverlayCanvas">
            <Border x:Name="HintSurface" Canvas.Left="16" Canvas.Top="16" Background="{DynamicResource OverlaySurfaceBrush}" BorderBrush="{DynamicResource OverlayAccentBrush}" BorderThickness="1" CornerRadius="12" Padding="16,8" MaxWidth="480">
                <TextBlock x:Name="HintText" Text="拖拽绘制采集区域 · 宽高 &gt; 100 px · ESC 取消"
                           Foreground="{DynamicResource OverlayTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Rectangle x:Name="SelectionRect"
                       Stroke="{DynamicResource OverlayAccentBrush}" StrokeThickness="2"
                       Fill="{DynamicResource OverlaySelectionBrush}"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="DimensionLabel" Text=""
                       Foreground="{DynamicResource OverlayTextBrush}" Background="{DynamicResource OverlaySurfaceBrush}" Padding="8,4" FontSize="14" LineHeight="20" FontFamily="Cascadia Mono, Consolas"
                       Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
