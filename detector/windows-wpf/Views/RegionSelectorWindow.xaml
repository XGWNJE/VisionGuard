<Window x:Class="VisionGuard.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        Cursor="Cross">
    <Grid>
        <!-- 背景图（仅在窗口子区域模式时显示） -->
        <Image x:Name="BackgroundImage" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 暗化遮罩（全屏模式时覆盖整个屏幕；窗口模式时覆盖图像） -->
        <Rectangle x:Name="DimOverlay" Fill="#AA000000"/>

        <!-- 交互画布 -->
        <Canvas x:Name="OverlayCanvas">
            <Border Canvas.Left="20" Canvas.Top="20" Background="#E6171719" BorderBrush="#66FF3B30" BorderThickness="1" CornerRadius="10" Padding="14,9">
                <TextBlock x:Name="HintText" Text="拖拽绘制采集区域 · 宽高 &gt; 100 px · ESC 取消"
                           Foreground="White" FontSize="14" FontWeight="SemiBold"/>
            </Border>
            <Rectangle x:Name="SelectionRect"
                       Stroke="#FFFF3B30" StrokeThickness="2"
                       Fill="#20FF3B30"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="DimensionLabel" Text=""
                       Foreground="#FFFF3B30" FontSize="13" FontFamily="Cascadia Mono, Consolas"
                       Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
