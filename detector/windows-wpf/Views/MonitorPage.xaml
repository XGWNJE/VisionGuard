<UserControl x:Class="VisionGuard.Views.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,8,8,8" DataContext="{Binding SelectedSource}">
            <!-- 当前上下文：名称原位编辑，失焦或回车自动保存 -->
            <Grid Margin="0,0,0,18" MinHeight="40">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SourceNameText"
                           Text="{Binding SourceName}"
                           Style="{StaticResource TitleText}"
                           FontSize="17"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Cursor="IBeam"
                           ToolTip="点击修改来源名称"
                           MouseLeftButtonDown="SourceNameText_OnMouseLeftButtonDown"/>
                <TextBox x:Name="SourceNameEditor"
                         Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}"
                         Visibility="Collapsed"
                         VerticalAlignment="Center"
                         LostKeyboardFocus="SourceNameEditor_OnLostKeyboardFocus"
                         KeyDown="SourceNameEditor_OnKeyDown"/>
                <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"/>
                </Border>
            </Grid>

            <!-- 1. 采集目标（窗口 / 选区 / 遮罩）：一个整体，共用一次重置 -->
            <StackPanel Margin="0,0,0,16">
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="采集目标" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="重置" Style="{StaticResource GhostButton}" Command="{Binding ResetTargetCommand}"
                            MinWidth="52" MinHeight="28" Height="28" Padding="9,2" ToolTip="清除窗口、选区与遮罩"/>
                </Grid>
                <TextBlock Text="{Binding TargetInfo}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetInfo}" Margin="0,0,0,7"/>
                <TextBlock Text="{Binding AspectRatioWarning}" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,-3,0,7"
                           Visibility="{Binding HasAspectRatioWarning, Converter={StaticResource BoolToVis}}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="应用窗口" Style="{StaticResource PrimaryButton}" Command="{Binding PickWindowCommand}" Margin="0,0,4,0" ToolTip="选择一个应用窗口作为采集目标"/>
                    <Button Grid.Column="1" Content="窗口 / 屏幕选区" Style="{StaticResource DarkButton}" Command="{Binding SelectRegionCommand}" Margin="4,0,0,0" ToolTip="已选择窗口时截取窗口内部区域，否则选择屏幕区域"/>
                </Grid>
                <TextBlock Text="{Binding MaskInfo}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,7,0,4"/>
                <Button Content="编辑遮罩区域" Style="{StaticResource DarkButton}" Command="{Binding EditMasksCommand}"/>
            </StackPanel>

            <!-- 2. 识别设置（改动即保存，重新启动此来源后生效） -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="识别设置" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <TextBlock Text="模型" Style="{StaticResource CaptionText}"/>
                <!-- 只列本机已下载的模型：未下载的模型选了也启动不了，不该出现在下拉里。
                     一个都没下载时下拉禁用，并在下方直接说明去哪里下载（不留空控件让人猜）。 -->
                <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding ModelKey}"
                          Style="{StaticResource DarkComboBox}" IsEnabled="{Binding CanPickModel}"
                          Height="40" Margin="0,4,0,0" ToolTip="{Binding NoModelHint}"/>
                <TextBlock Text="{Binding NoModelHint}" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"
                           Visibility="{Binding HasNoModel, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="检测类别" Style="{StaticResource CaptionText}"/>
                <Grid Margin="0,4,0,0">
                    <ToggleButton x:Name="TargetMenuButton" Height="40" IsEnabled="{Binding CanEdit}"
                                  AutomationProperties.Name="检测类别多选菜单"
                                  IsChecked="{Binding IsOpen, ElementName=TargetMenuPopup, Mode=TwoWay}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Shell" Background="{StaticResource SurfaceLight}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <Grid Margin="11,0,10,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TargetSummary}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource PrimaryHover}"/></Trigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="TargetMenuPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=TargetMenuButton}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="{Binding ActualWidth, ElementName=TargetMenuButton}" MaxHeight="310"
                                Background="{StaticResource SurfaceLight}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TargetOptions}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource DarkCheckBox}" Width="170" Padding="6" Margin="1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <!-- 3. 检测参数（同样改动即保存，重新启动此来源后生效） -->
            <StackPanel>
                <TextBlock Text="检测参数" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,3,0"><TextBlock Text="阈值 %" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding ThresholdPercent}" Style="{StaticResource DarkTextBox}" IsEnabled="{Binding CanEdit}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="3,0"><TextBlock Text="频率/秒" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding TargetFps}" Style="{StaticResource DarkTextBox}" IsEnabled="{Binding CanEdit}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="3,0,0,0"><TextBlock Text="冷却秒" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding Cooldown}" Style="{StaticResource DarkTextBox}" IsEnabled="{Binding CanEdit}" Margin="0,4,0,0"/></StackPanel>
                </Grid>
            </StackPanel>

            <!-- 参数改动即已保存；只有冷改动参数需要重新启动才生效，这里只说清这一点 -->
            <TextBlock Text="{Binding PendingApplyText}" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasPendingApply, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
