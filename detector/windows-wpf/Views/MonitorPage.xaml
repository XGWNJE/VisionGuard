<UserControl x:Class="VisionGuard.Detector.Windows.Views.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:icons="clr-namespace:VisionGuard.Detector.Windows.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,8,8,8" DataContext="{Binding SelectedSource}">
            <!-- 当前上下文：名称原位编辑，失焦或回车自动保存 -->
            <Grid Margin="0,0,0,16" MinHeight="40">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SelectedBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding SlotNumber}" Foreground="{DynamicResource SelectedTextBrush}" FontWeight="SemiBold"/></Border>
                <Button Grid.Column="1" x:Name="SourceNameText" Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,8,0"
                        HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                        AutomationProperties.Name="修改来源名称" ToolTip="点击或按 Enter 修改来源名称"
                        Click="SourceNameText_OnClick">
                    <TextBlock Text="{Binding SourceName}" Style="{StaticResource TitleText}" FontSize="16" LineHeight="24" TextWrapping="Wrap"/>
                </Button>
                <TextBox Grid.Column="1" x:Name="SourceNameEditor" DataObject.Pasting="SourceName_OnPasting"
                         MaxLength="64" ToolTip="名称须为 1–64 个字符，不能包含换行或控制字符"
                         Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                         Style="{StaticResource DarkTextBox}"
                         Visibility="Collapsed"
                         VerticalAlignment="Center"
                         LostKeyboardFocus="SourceNameEditor_OnLostKeyboardFocus"
                         KeyDown="SourceNameEditor_OnKeyDown"/>
                <Border Grid.Column="2" Style="{StaticResource StatusPill}" VerticalAlignment="Center" MaxWidth="136">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SourceStatusText}" TextWrapping="Wrap" ToolTip="{Binding StatusText}"/>
                </Border>
            </Grid>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="采集目标" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource SurfaceLight}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                    <TextBlock Text="{Binding TargetInfo}" Style="{StaticResource BodyText}" TextWrapping="Wrap" ToolTip="{Binding TargetInfo}"/>
                </Border>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="选择窗口" Command="{Binding PickWindowCommand}" Style="{StaticResource DarkButton}" MinHeight="36" Padding="4" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="选区" Command="{Binding SelectRegionCommand}" Style="{StaticResource DarkButton}" MinHeight="36" Padding="4" Margin="4,0"/>
                    <Button Grid.Column="2" Content="遮罩" Command="{Binding EditMasksCommand}" Style="{StaticResource DarkButton}" MinHeight="36" Padding="4" Margin="4,0,0,0"/>
                </Grid>
            </StackPanel>

            <Expander IsExpanded="False" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16">
                <Expander.Header><StackPanel>
                    <TextBlock Text="检测参数" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding ParameterSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="244" Margin="0,6,0,8"/>
                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="4" Padding="10,6">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="调整参数" Foreground="{DynamicResource SelectedTextBrush}"/><icons:LucideIcon Grid.Column="1" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource SelectedTextBrush}"/></Grid>
                    </Border>
                </StackPanel></Expander.Header>

            <StackPanel>
            <TextBlock Text="{Binding NoModelHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding ParameterRows}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8" PreviewKeyDown="ParameterEditor_OnKeyDown">
                        <StackPanel>
                            <Grid MinHeight="36"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ValueText}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Content="编辑" Style="{StaticResource GhostButton}" Command="{Binding EditCommand}" Padding="8,4" MinHeight="36"/>
                            </Grid>
                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <StackPanel IsEnabled="{Binding CanEdit}">
                                <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Draft}" Style="{StaticResource DarkComboBox}" Visibility="{Binding IsModel, Converter={StaticResource BoolToVis}}"/>
                                <UniformGrid Rows="1" Visibility="{Binding IsSampling, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
<Button Content="1" Command="{Binding SelectNumericCommand}" CommandParameter="1" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="1"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<Button Content="2" Command="{Binding SelectNumericCommand}" CommandParameter="2" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="2"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<Button Content="3" Command="{Binding SelectNumericCommand}" CommandParameter="3" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="3"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<Button Content="4" Command="{Binding SelectNumericCommand}" CommandParameter="4" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="4"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<Button Content="5" Command="{Binding SelectNumericCommand}" CommandParameter="5" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="5"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
</UniformGrid>
<StackPanel Visibility="{Binding IsCooldown, Converter={StaticResource BoolToVis}}"><UniformGrid Rows="1" Visibility="{Binding IsCooldown, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
<Button Content="5 秒" Command="{Binding SelectNumericCommand}" CommandParameter="5" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="5"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<Button Content="10 秒" Command="{Binding SelectNumericCommand}" CommandParameter="10" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="10"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<Button Content="30 秒" Command="{Binding SelectNumericCommand}" CommandParameter="30" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="30"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<Button Content="60 秒" Command="{Binding SelectNumericCommand}" CommandParameter="60" Margin="2,0" MinHeight="36" Padding="4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value="60"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
</UniformGrid><TextBlock Text="完整范围 · 1–300 秒" Style="{StaticResource CaptionText}" Margin="0,4"/><ComboBox ItemsSource="{Binding NumericOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft, Mode=TwoWay}" Style="{StaticResource DarkComboBox}" AutomationProperties.Name="选择冷却时间"/></StackPanel>
                                <StackPanel Visibility="{Binding IsConfidence, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Draft, StringFormat={}{0}%}" Style="{StaticResource TitleText}"/>
                                    <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                        <Button Content="降低" Style="{StaticResource DarkButton}" Padding="0" Command="{Binding DecreaseCommand}" AutomationProperties.Name="降低置信度"/>
                                        <Slider Grid.Column="1" Margin="8,0" Minimum="10" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NumericDraft, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="置信度阈值"/>
                                        <Button Grid.Column="2" Content="提高" Style="{StaticResource DarkButton}" Padding="0" Command="{Binding IncreaseCommand}" AutomationProperties.Name="提高置信度"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsTargets, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" AutomationProperties.Name="搜索检测目标" ToolTip="搜索中文或模型标签"/>
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding FilteredTargets}"><ItemsControl.ItemTemplate><DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}" Margin="0,4"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></CheckBox.ContentTemplate></CheckBox>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                                    <Button Content="还原" Style="{StaticResource GhostButton}" Command="{Binding RestoreCommand}" Margin="0,0,8,0"/>
                                    <Button Content="取消" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel></Expander>
            <Expander Header="更多来源信息" IsExpanded="False" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding MaskInfo}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AspectRatioWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasAspectRatioWarning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding BackendText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding InferenceText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding LastAlertText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="重置采集目标" Command="{Binding ResetTargetCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" ToolTip="清除窗口、选区与遮罩"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
