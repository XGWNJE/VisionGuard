<UserControl x:Class="VisionGuard.Detector.Windows.Views.SourceStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:VisionGuard.Detector.Windows.Icons"
    xmlns:local="clr-namespace:VisionGuard.Detector.Windows.Views">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="来源列表" FontWeight="SemiBold"/><TextBlock Text="{Binding PreviewSelectionText}" Style="{StaticResource CaptionText}" Margin="8,0,0,0"/><TextBlock Text="{Binding PreviewSelectionHint}" Foreground="{DynamicResource DangerBrush}" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviewSelectionHint}" Margin="8,0,0,0"/></StackPanel>
                        <Button Grid.Column="1" Content="{Binding GlobalViewToggleText}" Command="{Binding ToggleGlobalViewCommand}" Style="{StaticResource GhostButton}" MinHeight="36" Padding="8,4" Margin="8,0"/>
                        <Button Grid.Column="2" Command="{Binding SelectedSource.AddSourceCommand}" Style="{StaticResource GhostButton}" MinHeight="36" Padding="8,4" AutomationProperties.Name="添加来源" ToolTip="{Binding SelectedSource.AddSourceToolTip}" ToolTipService.ShowOnDisabled="True"><StackPanel Orientation="Horizontal"><icons:LucideIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/><TextBlock Text="添加来源" VerticalAlignment="Center"/></StackPanel></Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Margin="0,0,8,0" Width="{Binding ItemWidth, RelativeSource={RelativeSource AncestorType=local:SourceStrip}}" CornerRadius="8" Background="{DynamicResource SurfaceDark}">
                                    <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Grid>
                                        <Button Command="{Binding SelectCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="6" ToolTip="{Binding SourceName}" AutomationProperties.Name="{Binding SourceName, StringFormat={}查看来源：{0}}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource CanvasBrush}" CornerRadius="4" Height="48" ClipToBounds="True"><Image Source="{Binding PreviewImage}" Stretch="Uniform"/></Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FpsText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel>
                                            </Grid>
                                        </Button>
                                        <CheckBox Style="{StaticResource DarkCheckBox}" Command="{Binding TogglePreviewCommand}" IsChecked="{Binding IsPreviewSelected, Mode=OneWay}" MinHeight="36" MinWidth="36" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" ToolTip="勾选进入预览；最多 4 路" AutomationProperties.Name="{Binding SourceName, StringFormat={}切换预览：{0}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
</UserControl>
