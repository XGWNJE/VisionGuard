<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VisionGuard.Detector.Windows.Views.AddSourceWindow" Title="添加来源" Width="480" Height="300" MinWidth="400" MinHeight="280" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundDark}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="选择采集方式" Style="{StaticResource TitleText}" FontSize="16"/>
            <TextBlock Text="配置成功后才加入来源列表；远程镜头绑定后自动加入。" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Center">
            <Button Content="采集窗口" Style="{StaticResource PaneButton}" Click="PickWindow_OnClick" Margin="0,0,4,0"/>
            <Button Content="屏幕选区" Style="{StaticResource PaneButton}" Click="PickRegion_OnClick" Margin="4,0,0,0"/>
        </UniformGrid>
        <Button Grid.Row="2" Content="取消" Style="{StaticResource PaneButton}" Width="112" HorizontalAlignment="Right" IsCancel="True"/>
    </Grid>
</Window>
