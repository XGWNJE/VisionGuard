<Window x:Class="VisionGuard.Detector.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VisionGuard.Detector.Windows.ViewModels"
        xmlns:icons="clr-namespace:VisionGuard.Detector.Windows.Icons"
        xmlns:local="clr-namespace:VisionGuard.Detector.Windows.Views"
        Title="视觉节点" Width="1420" Height="800" MinWidth="1040" MinHeight="540"
        Background="{DynamicResource BackgroundDark}" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/favico3n.ico" Width="24" Height="24" Margin="0,0,8,0"/>
                    <TextBlock Text="VisionGuard" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="视觉节点" Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GlobalSettingsVm.Connection.DeviceName}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding GlobalSettingsVm.Connection.DeviceName}" Margin="0,0,16,0"/>
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding GlobalSettingsVm.Connection.IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource Primary}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding GlobalSettingsVm.Connection.ConnectionState}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding GlobalSettingsVm.Connection.ConnectionState}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CardIconButton}" Click="OpenGlobalSettings_OnClick" Margin="12,0,0,0" AutomationProperties.Name="打开全局设置" ToolTip="外观、推理设备、模型资源与账号"><icons:LucideIcon Kind="Settings" Width="20" Height="20"/></Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="MainLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CardsColumn" Width="*" MinWidth="680"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="{Binding MultiSourceVm.InspectorWidth, Mode=TwoWay}" MinWidth="320"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="CardsHost" Margin="12">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False" Visibility="{Binding MultiSourceVm.IsPreviewView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding MultiSourceVm.PreviewSources}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                            <local:CardGridPanel Host="{Binding MultiSourceVm}" FocusedIndex="{Binding MultiSourceVm.FocusedPreviewIndex}"
                                ViewportWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                ViewportHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                        </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <local:SourcePreviewCard IsPrimary="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(local:CardGridPanel.IsPrimaryCard)}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid Visibility="{Binding MultiSourceVm.IsGlobalView, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="勾选进入预览的来源，最多 4 路；其余来源继续采集与检测。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MultiSourceVm.Sources}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:GlobalSourcePanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Margin="4" CornerRadius="8" Background="{DynamicResource SurfaceDark}">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Button Command="{Binding SelectCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,4" ToolTip="{Binding SourceName}" AutomationProperties.Name="{Binding SourceName, StringFormat={}查看来源：{0}}"><StackPanel><TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource SourceStatusText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Button>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsPreviewSelected, Mode=OneWay}" Command="{Binding TogglePreviewCommand}" Style="{StaticResource DarkCheckBox}" ToolTip="勾选进入预览；最多 4 路" AutomationProperties.Name="{Binding SourceName, StringFormat={}切换预览：{0}}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <local:SourceStrip Grid.Row="1" Margin="0,12,0,0" DataContext="{Binding MultiSourceVm}"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE" DragCompleted="CardsSplitter_OnDragCompleted" ToolTip="调整预览区与检查区宽度"/>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <TabControl x:Name="MainInspector" Margin="12,8" Style="{StaticResource InspectorTabs}" Background="Transparent">
                    <TabItem Header="当前来源" Style="{StaticResource InspectorTabItem}"><local:MonitorPage DataContext="{Binding MultiSourceVm}"/></TabItem>
                    <TabItem Header="全局设置" Style="{StaticResource InspectorTabItem}"><local:GlobalSettingsPage DataContext="{Binding GlobalSettingsVm}"/></TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
