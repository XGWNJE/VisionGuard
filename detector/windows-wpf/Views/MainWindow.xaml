<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:VisionGuard.Detector.Windows.ViewModels" xmlns:local="clr-namespace:VisionGuard.Detector.Windows.Views" x:Class="VisionGuard.Detector.Windows.Views.MainWindow" Title="视觉节点" Width="1420" Height="800" MinWidth="720" MinHeight="480" Background="{DynamicResource BackgroundDark}" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="PaneResizeHandle" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="ResizeLine" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResizeLine" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ResizeLine" Property="Opacity" Value="1"/><Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource Primary}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ResizeLine" Property="Opacity" Value="1"/><Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource Primary}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid x:Name="MainLayout" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CardsColumn" Width="*" MinWidth="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="SourcesColumn" Width="280" MinWidth="240" MaxWidth="380"/>
                <ColumnDefinition x:Name="InspectorGap" Width="8"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="320" MaxWidth="420"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <local:SourcePreviewCard IsPrimary="True" DataContext="{Binding MultiSourceVm.SelectedSource}" Visibility="{Binding MultiSourceVm.HasSelectedSource, Converter={StaticResource BoolToVis}}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MultiSourceVm.HasSources}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="添加第一个来源" Style="{StaticResource TitleText}" FontSize="16" TextAlignment="Center"/>
                    <TextBlock Text="选择采集窗口或屏幕区域后，来源会出现在列表中。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>
                    <Button Content="添加来源" Style="{StaticResource PanePrimaryButton}" Command="{Binding MultiSourceVm.AddSourceCommand}"/>
                </StackPanel>
            </Grid>
            <Thumb x:Name="SourcesSplitter" Grid.Column="1" Style="{StaticResource PaneResizeHandle}" DragStarted="PaneResize_OnDragStarted" DragDelta="PaneResize_OnDragDelta" DragCompleted="PaneResize_OnDragCompleted" KeyDown="PaneResize_OnKeyDown" AutomationProperties.Name="调整来源列表宽度" ToolTip="调整来源列表宽度 · 左右方向键细调"/>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding MultiSourceVm.SourceCountText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
                    <ListBox x:Name="SourceList" Grid.Row="1" ItemsSource="{Binding MultiSourceVm.Sources}" SelectedItem="{Binding MultiSourceVm.SelectedSource}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:SourcePreviewCard/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="{Binding MultiSourceVm.SourceNotice}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="4,8" Visibility="{Binding MultiSourceVm.HasSourceNotice, Converter={StaticResource BoolToVis}}"/>
                    <UniformGrid x:Name="SourceFooter" Grid.Row="3" Columns="1" Margin="0,8,0,0">
                        <Button Content="添加来源" Style="{StaticResource PaneButton}" Command="{Binding MultiSourceVm.AddSourceCommand}" ToolTip="{Binding MultiSourceVm.SourceLimitText}" ToolTipService.ShowOnDisabled="True" Margin="0,0,4,0"/>
                        <Button x:Name="InspectorToggle" Content="来源检查" Style="{StaticResource PaneButton}" Click="ToggleInspector_OnClick" Margin="4,0,0,0" Visibility="Collapsed"/>
                    </UniformGrid>
                </Grid>
            </Border>
            <Thumb x:Name="InspectorSplitter" Grid.Column="3" Style="{StaticResource PaneResizeHandle}" DragStarted="PaneResize_OnDragStarted" DragDelta="PaneResize_OnDragDelta" DragCompleted="PaneResize_OnDragCompleted" KeyDown="PaneResize_OnKeyDown" AutomationProperties.Name="调整来源检查区宽度" ToolTip="调整检查区宽度 · 左右方向键细调"/>
            <Border x:Name="InspectorHost" Grid.Column="4" Background="{DynamicResource SurfaceDark}" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:MonitorPage DataContext="{Binding MultiSourceVm}"/>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="16,12">
                        <Button Content="全局设置" Style="{StaticResource PaneButton}" Click="OpenGlobalSettings_OnClick"/>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="CompactActions" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Visibility="Collapsed" Margin="12">
                <Button Content="全局设置" Style="{StaticResource PaneButton}" Width="112" Click="OpenGlobalSettings_OnClick"/>
            </Border>
        </Grid>
        <Border x:Name="InspectorDrawer" Background="{DynamicResource SurfaceDark}" HorizontalAlignment="Right" Width="336" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Content="返回预览" Style="{StaticResource PaneButton}" Click="CloseInspector_OnClick" Margin="16,12"/>
                <local:MonitorPage Grid.Row="1" DataContext="{Binding MultiSourceVm}"/>
                <Button Grid.Row="2" Content="全局设置" Style="{StaticResource PaneButton}" Click="OpenGlobalSettings_OnClick" Margin="16,12"/>
            </Grid>
        </Border>
        <Border x:Name="GlobalHost" Background="{DynamicResource BackgroundDark}" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Content="返回预览" Style="{StaticResource PaneButton}" Click="CloseGlobalSettings_OnClick"/>
                    <TextBlock Grid.Column="1" Text="全局设置" Style="{StaticResource TitleText}" FontSize="16" VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
                <local:GlobalSettingsPage Grid.Row="1" DataContext="{Binding GlobalSettingsVm}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
