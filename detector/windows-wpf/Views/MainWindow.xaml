<Window x:Class="VisionGuard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VisionGuard.ViewModels"
        xmlns:local="clr-namespace:VisionGuard.Views"
        mc:Ignorable="d"
        Title="VisionGuard"
        Width="1420" Height="880" MinWidth="1100" MinHeight="700"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 单一顶栏：品牌、运行状态与整机操作 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding MultiSourceVm.RunningSummary}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                    </Border>
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding MultiSourceVm.ConnectionSummary}" Style="{StaticResource CaptionText}"/>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <TextBlock Text="{Binding MultiSourceVm.ErrorSummary}" Style="{StaticResource CaptionText}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="启动已配置" Style="{StaticResource PrimaryButton}" Command="{Binding MultiSourceVm.StartConfiguredCommand}" Margin="0,0,8,0"/>
                    <Button Content="全部停止" Style="{StaticResource DangerButton}" Command="{Binding MultiSourceVm.StopAllCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中央只承担监控；右侧是唯一配置入口 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620"/>
                <ColumnDefinition Width="376"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8,7,7,7">
                <ItemsControl ItemsSource="{Binding MultiSourceVm.Sources}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="2" Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="7" CornerRadius="12" Background="{StaticResource SurfaceDark}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>

                                    <Button Grid.Row="0" Style="{StaticResource GhostButton}" Command="{Binding SelectCommand}" HorizontalContentAlignment="Stretch" Padding="7,2" MinHeight="34" Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource Primary}" VerticalAlignment="Center" Margin="6,0,1,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SourceName}" Style="{StaticResource TitleText}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <Border Grid.Row="1" Background="{StaticResource CanvasBrush}" BorderBrush="#FF1C2731" BorderThickness="1" CornerRadius="9" ClipToBounds="True" MinHeight="210">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230">
                                                <TextBlock Text="暂无画面" Foreground="#FF5A5A60" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding TargetInfo}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Viewbox Stretch="Uniform" Margin="3">
                                                <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}">
                                                    <Image Source="{Binding PreviewImage}" Stretch="None"/>
                                                    <ItemsControl ItemsSource="{Binding Detections}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas IsItemsHost="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate><DataTemplate><Grid><Rectangle Width="{Binding Width}" Height="{Binding Height}" Stroke="{StaticResource DangerBrush}" StrokeThickness="2"/><TextBlock Text="{Binding Label}" Foreground="White" Background="#DDFF6B5E" FontSize="10" Padding="4,1" VerticalAlignment="Top" Margin="0,-17,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Viewbox>
                                            <Border Background="#E6101011" VerticalAlignment="Bottom" Padding="9,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding LastFrameText}" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding InferenceText}" Style="{StaticResource CaptionText}" Margin="12,0,0,0"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding LastAlertText}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BackendText}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="12,3,0,0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Content="启动此路" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,3,0" Padding="10,5" MinHeight="36"/>
                                        <Button Grid.Column="1" Content="停止" Style="{StaticResource GhostButton}" Command="{Binding StopCommand}" Margin="3,0,0,0" Padding="10,5" MinHeight="36"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource MutedSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="12,8,10,8">
                    <TabControl Style="{StaticResource InspectorTabs}" Background="Transparent">
                        <TabItem Header="当前信号" Style="{StaticResource InspectorTabItem}">
                            <local:MonitorPage DataContext="{Binding MultiSourceVm}"/>
                        </TabItem>
                        <TabItem Header="运行环境" Style="{StaticResource InspectorTabItem}">
                            <local:SettingsPage DataContext="{Binding SettingsVm}"/>
                        </TabItem>
                        <TabItem Header="连接" Style="{StaticResource InspectorTabItem}">
                            <local:ServerPage DataContext="{Binding ServerVm}"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
