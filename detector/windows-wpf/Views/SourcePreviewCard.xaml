<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VisionGuard.Detector.Windows.Views" x:Class="VisionGuard.Detector.Windows.Views.SourcePreviewCard">
    <Grid>
        <Border Background="{DynamicResource CanvasBrush}" CornerRadius="8"/>
        <Grid x:Name="CardContent" Margin="2" SizeChanged="CardContent_OnSizeChanged">
            <Grid.Clip>
                <RectangleGeometry x:Name="CardContentClip" RadiusX="6" RadiusY="6"/>
            </Grid.Clip>
            <local:UniformFramePresenter>
                <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}">
                    <Image Source="{Binding PreviewImage}" Stretch="None"/>
                    <ItemsControl ItemsSource="{Binding Detections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Stroke="{DynamicResource DetectionBrush}" StrokeThickness="2"/>
                                    <local:FrameLabel Text="{Binding Label}" SourceLeft="{Binding Left}" SourceTop="{Binding Top}" FrameWidth="{Binding DataContext.FrameWidth, RelativeSource={RelativeSource AncestorType=local:SourcePreviewCard}}" Visibility="{Binding IsPrimary, RelativeSource={RelativeSource AncestorType=local:SourcePreviewCard}, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Label}" Foreground="{DynamicResource OverlayTextBrush}" Background="{DynamicResource DetectionLabelBrush}" FontSize="12" Padding="4,1" VerticalAlignment="Top" Margin="0,-19,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </local:UniformFramePresenter>
            <TextBlock Text="暂无画面" Foreground="{DynamicResource OverlaySecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Background="{DynamicResource OverlaySurfaceBrush}" VerticalAlignment="Top">
                <Button Command="{Binding SelectCommand}" Style="{StaticResource GhostButton}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OverlayTextBrush}" HorizontalContentAlignment="Stretch" Padding="8,4" ToolTip="选择此来源">
                    <StackPanel>
                        <TextBlock Text="{Binding SourceName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceName}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource OverlaySecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusToolTip}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding FpsText}" Foreground="{DynamicResource OverlaySecondaryBrush}" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Button>
            </Border>
            <TextBlock Text="{Binding LastFrameText, StringFormat={}已停止 · 保留最后画面 · {0}}" Foreground="{DynamicResource OverlaySecondaryBrush}" Background="{DynamicResource OverlaySurfaceBrush}" FontSize="12" Padding="8,4" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMonitoring}" Value="False"/>
                                    <Condition Binding="{Binding IsPrimary, RelativeSource={RelativeSource AncestorType=local:SourcePreviewCard}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <!-- 边框最后绘制，画面和标题不能覆盖圆角或选中描边。 -->
        <Border CornerRadius="8" BorderThickness="2" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
