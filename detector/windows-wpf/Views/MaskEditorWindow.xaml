<Window x:Class="VisionGuard.Views.MaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VisionGuard.ViewModels"
        Title="遮罩区域编辑"
        WindowStyle="None"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        MinWidth="520"
        MinHeight="360"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 图像 + 遮罩 Canvas -->
        <Grid Grid.Row="0">
            <Image x:Name="BackgroundImage" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Canvas x:Name="MaskCanvas" Background="Transparent"
                    MouseLeftButtonDown="MaskCanvas_MouseLeftButtonDown"
                    MouseMove="MaskCanvas_MouseMove"
                    MouseLeftButtonUp="MaskCanvas_MouseLeftButtonUp"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="12,8" Background="#E6171719" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="拖拽绘制遮罩 · 遮罩区域不会参与检测" Foreground="White" FontSize="13"/>
            </Border>
        </Grid>

        <!-- 底部工具栏 -->
        <Border Grid.Row="1" Background="#FA171719" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="12">
                <Button Content="撤销" Style="{StaticResource GhostButton}" Margin="4,0"
                        Command="{Binding UndoCommand}"/>
                <Button Content="清空遮罩" Style="{StaticResource DangerButton}" Margin="4,0"
                        Command="{Binding ClearCommand}"/>
                <Separator Margin="8,0" Style="{x:Null}" Width="1" Background="{StaticResource BorderBrush}"/>
                <Button Content="取消" Style="{StaticResource DarkButton}" Margin="4,0" Click="Cancel_Click"/>
                <Button Content="保存遮罩" Style="{StaticResource PrimaryButton}" Margin="4,0" Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
