<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VisionGuard.Detector.Windows</AssemblyName>
    <RootNamespace>VisionGuard.Detector.Windows</RootNamespace>
    <Title>视觉节点</Title>
    <AssemblyTitle>视觉节点</AssemblyTitle>
    <Product>视觉节点</Product>
    <Description>视觉节点，本地画面与远程镜头推理</Description>
    <!-- 视觉节点统一为单一 net472 构建：Windows 7 SP1 x64 与 Windows 10/11 共用同一份
         WPF 源码。两平台的差异只在推理档位（原生 ONNX Runtime 版本、是否启用 DirectML）
         与模型清单，由 Runtime/NativeLibrarySelector.cs 在启动时按运行环境选择。 -->
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 实际输出目录在下方按 OrtProfile 指定为 bin\x64\<档位>\。 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>favico3n.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AllowedReferenceRelatedFileExtensions>.allowedextension</AllowedReferenceRelatedFileExtensions>
    <Platforms>AnyCPU;x86</Platforms>
    <Version>0.6.8</Version>
    <FileVersion>0.6.8</FileVersion>
    <AssemblyVersion>0.6.8</AssemblyVersion>
    <!-- net472 下必须显式生成绑定重定向，否则 System.Text.Json 的依赖无法解析。 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <!-- net472 依赖缺少 nullable 元数据，屏蔽对应的结构性警告。 -->
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    推理档位：档位、托管包与版本、编译期开关、输出目录和原生库布置
    全部由共享定义推导，检测端与其验证工程必须用同一份，否则会出现假验证。
  -->
  <Import Project="..\windows-shared\NativeLibraries.props" />

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <Reference Include="System.Security" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="$(OrtManagedPackage)" Version="$(OrtManagedVersion)" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <!--
      legacy 档原生 1.1.0 的唯一来源。只登记包、不引用其中任何资产（ExcludeAssets=all），
      真正需要的是 native\win-x64\onnxruntime.dll，由 ArrangeNativeLibraries 复制到 native\legacy\ 后预加载。
      GeneratePathProperty 生成 PkgMicrosoft_ML_OnnxRuntime_1_1_0 指向包目录，避免依赖包目录布局写死路径。

      必须只在 legacy 档登记：该包的托管程序集是 ONNX Runtime 1.2.0，
      modern 档一旦同时解析到它，DirectML 相关的 AppendExecutionProvider_DML 就会消失（编译失败）。
     -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.1.0" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" Condition="'$(OrtProfile)' == 'legacy'" />
  </ItemGroup>

  <!--
    每个推理档位输出都包含驻留程序，以支持离线目录分发和远程重新打开检测端。
    build-all.ps1 先构建驻留再构建 WPF；统一包由 assemble-windows-unified.js 汇集。
    直接构建 WPF 时缺少驻留会给出警告。
  -->
  <PropertyGroup>
    <ResidentOutputDir>$(MSBuildThisFileDirectory)..\windows-resident\bin\Release\net472\</ResidentOutputDir>
  </PropertyGroup>

  <Target Name="IncludeResidentInOutput" AfterTargets="Build">
    <ItemGroup>
      <ResidentPayload Include="$(ResidentOutputDir)VisionGuard.Resident.Windows.exe;$(ResidentOutputDir)VisionGuard.Resident.Windows.exe.config" />
    </ItemGroup>
    <Copy SourceFiles="@(ResidentPayload)" DestinationFolder="$(OutputPath)" Condition="Exists('$(ResidentOutputDir)VisionGuard.Resident.Windows.exe')" />
    <Warning Text="检测端输出目录未包含驻留程序：$(ResidentOutputDir)VisionGuard.Resident.Windows.exe 不存在。请先构建 Windows Resident，或使用 visionguard-build -Target Windows。"
             Condition="!Exists('$(ResidentOutputDir)VisionGuard.Resident.Windows.exe')" />
  </Target>

  <ItemGroup>
    <!-- WPF 项在 net472 下不能依赖 SDK 的隐式推导，必须显式声明。 -->
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Themes\DarkTheme.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\MainWindow.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\MonitorPage.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\SourcePreviewCard.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\AddSourceWindow.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\ParameterEditorWindow.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\GlobalSettingsPage.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\MaskEditorWindow.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\RegionSelectorWindow.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Page Include="Views\WindowPickerWindow.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- 模型文件只作为发布输入，不进入应用构建项或输出。 -->
    <None Remove="Assets\**" />
    <Resource Include="favico3n.ico" />
    <EmbeddedResource Include="..\..\assets\vendor\lucide\LICENSE" Link="ThirdParty\Lucide.LICENSE" />
    <Content Include="..\..\assets\vendor\lucide\LICENSE" Link="third-party\lucide-license.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\windows-shared\Utils\AccountSession.cs" Link="Utils\AccountSession.cs" />
    <Compile Include="..\windows-shared\Utils\SharedSettingsFile.cs" Link="Utils\SharedSettingsFile.cs" />
    <Compile Include="..\windows-shared\Utils\SourceSettingsMigration.cs" Link="Utils\SourceSettingsMigration.cs" />
    <Compile Include="..\windows-shared\Capture\CaptureSizeConstraints.cs" Link="Capture\CaptureSizeConstraints.cs" />
    <Compile Include="..\windows-shared\Capture\CaptureBlackFrameException.cs" Link="Capture\CaptureBlackFrameException.cs" />
    <Compile Include="..\windows-shared\Utils\SingleInstanceGuard.cs" Link="Utils\SingleInstanceGuard.cs" />
    <Compile Include="..\windows-shared\Services\RemoteControlEventArgs.cs" Link="Services\RemoteControlEventArgs.cs" />
    <Compile Include="..\windows-shared\Services\ResidentBridge.cs" Link="Services\ResidentBridge.cs" />
  </ItemGroup>

</Project>
