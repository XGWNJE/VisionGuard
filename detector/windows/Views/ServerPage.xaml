<UserControl x:Class="VisionGuard.Views.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDark}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="服务器连接" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding ConnectionState}" Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Button Content="重试连接" Style="{StaticResource DarkButton}" Command="{Binding RetryCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="设备名称" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding DeviceName}" Margin="0,0,0,8"/>
                    <Button Content="应用" Style="{StaticResource PrimaryButton}" Width="80" HorizontalAlignment="Left"
                            Command="{Binding ApplyNameCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
