<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 与 detector/windows-wpf 一致：Windows 检测端统一为 net472。 -->
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\detector\windows-shared\Utils\ApiKeyProvider.cs" Link="ApiKeyProvider.cs" />
    <Compile Include="..\..\detector\windows-shared\Utils\SharedSettingsFile.cs" Link="SharedSettingsFile.cs" />
    <Compile Include="..\..\detector\windows-shared\Utils\SourceSettingsMigration.cs" Link="SourceSettingsMigration.cs" />
    <Compile Include="..\..\detector\windows-winforms\Models\MonitorConfig.cs" Link="WinFormsMonitorConfig.cs" />
    <Compile Include="..\..\detector\windows-winforms\Models\MonitorSource.cs" Link="WinFormsMonitorSource.cs" />
    <Compile Include="..\..\detector\windows-shared\Capture\CaptureSizeConstraints.cs" Link="CaptureSizeConstraints.cs" />
    <Compile Include="..\..\detector\windows-shared\Capture\CaptureBlackFrameException.cs" Link="CaptureBlackFrameException.cs" />
    <Compile Include="..\..\detector\windows-wpf\Capture\NativeMethods.cs" Link="NativeMethods.cs" />
    <Compile Include="..\..\detector\windows-wpf\Capture\WindowEnumerator.cs" Link="WindowEnumerator.cs" />
    <Compile Include="..\..\detector\windows-wpf\Capture\WindowInfo.cs" Link="WindowInfo.cs" />
    <Compile Include="..\..\detector\windows-wpf\Capture\WindowCapturer.cs" Link="WindowCapturer.cs" />
    <Compile Include="..\..\detector\windows-wpf\Capture\WindowMatchResolver.cs" Link="WindowMatchResolver.cs" />
    <Compile Include="..\..\detector\windows-wpf\Services\MonitorFailureKind.cs" Link="MonitorFailureKind.cs" />
    <Compile Include="..\..\detector\windows-wpf\Services\CapacityPolicy.cs" Link="CapacityPolicy.cs" />
    <Compile Include="..\..\detector\windows-wpf\Services\AlertOutbox.cs" Link="AlertOutbox.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- AlertOutbox 以源码链接方式参与编译，需要它依赖的 JSON 与 net472 兼容层。 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\detector\windows-wpf\Runtime\IsExternalInit.cs" Link="IsExternalInit.cs" />
    <Compile Include="..\..\detector\windows-wpf\Runtime\Net472Compat.cs" Link="Net472Compat.cs" />
  </ItemGroup>
</Project>
