detector/android/.cxx/
detector/android/key/
detector/android/keystore.properties
detector/android/app/*.jks
detector/android/.key/det

# ===== Android 接收端 =====
receiver/web/node_modules/
detector/web/node_modules/
receiver/android/*.iml
receiver/android/.gradle/
receiver/android/.idea/
receiver/android/.kotlin/
receiver/android/local.properties
receiver/android/build/
receiver/android/app/build/
receiver/android/app/release/
receiver/android/.externalNativeBuild/
receiver/android/.cxx/
receiver/android/key/
receiver/android/keystore.properties
receiver/android/app/*.jks

# ===== 模型与发行产物 =====
# 只忽略仓库根的 models/。不要写成无前导斜杠的 models/：
# Windows 文件系统大小写不敏感，会连 detector/windows-wpf/Models/ 一起忽略，
# 导致 MonitorSource.cs 这类源码永远提交不上去（干净克隆直接编译失败）。
/models/
*.apk
*.psd


# ===== Android 通知节点 =====
notifier/android/.gradle/
notifier/android/.idea/
notifier/android/.kotlin/
notifier/android/local.properties
notifier/android/build/
notifier/android/app/build/
notifier/android/app/release/
notifier/android/keystore.properties
notifier/android/key/
notifier/android/keystore/
notifier/android/**/*.jks

# ===== Android 视觉推理节点 =====
detector/android-inference/.gradle/
detector/android-inference/.idea/
detector/android-inference/.kotlin/
detector/android-inference/local.properties
detector/android-inference/build/
detector/android-inference/app/build/
detector/android-inference/app/release/
detector/android-inference/keystore.properties
detector/android-inference/key/
detector/android-inference/keystore/
detector/android-inference/**/*.jks

# 推理加速测量自带模型：与生产模型一样不入版本控制（单个 640 模型就有几十 MiB）。
# 资产在 **debug 源集**（只在调试构建里，正式包不带），本地复现方式见该目录 README.md。
detector/android-inference/app/src/debug/assets/bench-models/
detector/android-inference/app/src/debug/assets/bench-frames/
# 旧位置：资产曾挂在 main 源集，规则保留一段时间，避免老的本地目录被误提交。
detector/android-inference/app/src/main/assets/bench-models/
detector/android-inference/app/src/main/assets/bench-frames/
